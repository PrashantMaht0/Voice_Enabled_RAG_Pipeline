{
  "name": "vrag-live-demo",
  "private": true,
  "type": "module",
  "description": "The V-RAG live demo: the question pipeline in the browser, published on GitHub Pages.",
  "scripts": {
    "python": "node scripts/bundle_python.mjs",
    "dev": "npm run python && vite --port 5175 --strictPort",
    "build": "npm run python && tsc --noEmit && vite build",
    "test": "node --experimental-transform-types --no-warnings --test tests/*.test.ts",
    "preview": "vite preview --port 5176 --strictPort"
  },
  "dependencies": {
    "@gradio/client": "2.7.1",
    "@huggingface/transformers": "4.3.1",
    "@mlc-ai/web-llm": "0.2.86",
    "kokoro-js": "1.2.1"
  },
  "devDependencies": {
    "fflate": "0.8.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
