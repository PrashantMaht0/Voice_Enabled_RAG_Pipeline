{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "kokoro-transformers": [
        "./node_modules/kokoro-js/node_modules/@huggingface/transformers"
      ]
    }
  },
  "include": [
    "src"
  ]
}
